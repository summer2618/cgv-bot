# Discord 채널 설정 > 연동 > 웹후크 에서 발급받은 URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 모니터링할 영화. "movNo:표시이름" 을 콤마로 구분. 표시이름은 생략 가능.
# movNo는 CGV 영화 상세 페이지 URL에서 확인:
#   https://cgv.co.kr/cnm/cgvChart/movieChart/30001350  -> movNo=30001350
MOVIE_IDS=30001350:경주기행

# 몇 초마다 확인할지 (기본 120초). 너무 짧게 잡지 마세요.
POLL_INTERVAL_SECONDS=120

# 봇을 처음 켰을 때 이미 예매가 열려있는 상태였다면 알림을 보낼지 여부
NOTIFY_IF_ALREADY_OPEN=false

# 상태 저장 파일 경로 (재시작해도 중복 알림 안 가도록 기억함)
STATE_FILE=state.json

# ---- watch_showtime.py (특정 영화관+상영관 타입의 "신규 회차 오픈" 감지) 설정 ----
# "라벨|movNo|siteNo|attrCd" 를 세미콜론(;)으로 구분. attrCd 생략 시 전체 상영관 대상.
# siteNo는 `python watch_showtime.py --find-site {movNo} {극장이름검색어}` 로 찾을 수 있음.
# attrCd 코드: IMAX=04, SCREENX=08, 4DX=03, ULTRA 4DX=09, DOLBY ATMOS=06
SHOWTIME_WATCHES=용산아이파크몰 IMAX 오디세이|30001323|0013|04

SHOWTIME_POLL_INTERVAL_SECONDS=15
SHOWTIME_STATE_FILE=showtime_state.json
COOKIE_REWARM_EVERY_CYCLES=100

# 잔여좌석이 몇 석 이상 늘어나면(취소표 발생 등) 알림을 보낼지. 기본 2석.
SHOWTIME_MIN_SEAT_INCREASE=2

# 이 날짜(YYYYMMDD)부터의 회차만 좌석 상세(잔여좌석)까지 체크. 비워두면 열려있는 전체
# 날짜를 다 체크(그만큼 폴링마다 요청이 늘어남). "신규 날짜 오픈" 감지는 이 값과 무관하게
# 항상 열려있는 모든 날짜를 대상으로 함.
SHOWTIME_SEAT_CHECK_FROM_DATE=20260905
